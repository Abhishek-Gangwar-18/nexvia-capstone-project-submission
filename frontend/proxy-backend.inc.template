# Rendered to /etc/nginx/conf.d/proxy-backend.inc (not *.conf, so it's only included where named).
proxy_pass http://${BACKEND_UPSTREAM};
proxy_set_header Host $http_host;
# $remote_addr is the TCP peer, or the real client IP if (and only if) the peer is a trusted proxy.
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $fb_forwarded_proto;
# nginx's own unique id becomes Django's request id (returned to the browser as X-Request-ID).
proxy_set_header X-Request-ID $request_id;
proxy_read_timeout 120s;
proxy_request_buffering off;
