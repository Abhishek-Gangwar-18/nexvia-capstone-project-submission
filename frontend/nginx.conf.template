# Rendered by the nginx image entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# The files under /etc/nginx/snippets/ are generated at start-up by docker/40-security-snippets.sh from
# ADMIN_ALLOWLIST, TRUSTED_PROXY_CIDRS and CSP_HEADER (see that script).

# Keep the scheme set by a TLS-terminating proxy in front of us; fall back to our own.
map $http_x_forwarded_proto $fb_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# Access log without secrets. Password-reset links (/reset-password/<uid>/<token>), invitation pages
# (/invite/<token>) and the invite preview API carry a secret in the path, and a query string can carry one
# too (?next=%2Finvite%2F<token>, ?token=...). The logged URI masks the whole secret part; the first matching
# regex wins. Method, status, timings and upstream status stay in the line.
map $request_uri $fb_log_uri {
    default $request_uri;
    "~*^(?<fb_secret_prefix>/(?:reset-password|invite|api/invitations/preview))/"  "$fb_secret_prefix/[REDACTED]";
    "~*^(?<fb_query_path>[^?]*)\?.*(?:/|%2F)(?:reset-password|invite|invitations)(?:/|%2F)"  "$fb_query_path?[REDACTED]";
    "~*^(?<fb_param_path>[^?]*)\?(?:.*&)?(?:token|uid|key|secret|password|code|refresh|access)="  "$fb_param_path?[REDACTED]";
}

# API requests whose query string carries a secret: handled by the quiet internal location below.
map $args $fb_secret_query {
    default 0;
    "~*(?:^|&)(?:token|uid|key|secret|password|code|refresh|access)="  1;
    "~*(?:/|%2F)(?:reset-password|invite|invitations)(?:/|%2F)"         1;
}

log_format fb_redacted '$remote_addr - $remote_user [$time_local] "$request_method $fb_log_uri $server_protocol" '
                       '$status $body_bytes_sent rt=$request_time ups=$upstream_status urt=$upstream_response_time '
                       '"$http_user_agent"';

# Per client IP (the real client IP only when it came through a trusted proxy, see real-ip.conf).
limit_req_zone $binary_remote_addr zone=admin_login:10m rate=10r/m;

server {
    listen 80;
    server_name _;
    server_tokens off;  # no nginx version in the Server header or on error pages
    access_log /var/log/nginx/access.log fb_redacted;  # replaces the default "main" log (raw request line)
    # Error logging stays at nginx's normal level here. Routes whose path carries a secret (below) log only
    # critical errors, because nginx's error lines print the raw request line and upstream URL and that
    # format can't be changed.

    # Real client IP from X-Forwarded-For, but ONLY when the TCP peer is a configured proxy.
    include /etc/nginx/snippets/real-ip.conf;

    root /usr/share/nginx/html;
    index index.html;

    # Enterprise plan allows 100 MB attachments; the API enforces each plan's own limit.
    client_max_body_size 110m;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Django admin: allowlisted client IPs only (ADMIN_ALLOWLIST). Everyone else gets a plain 404, so the
    # admin's existence isn't advertised. The login form is also rate limited per client IP.
    location ^~ /admin/ {
        include /etc/nginx/snippets/admin-access.conf;
        error_page 403 =404 @not_found;

        location = /admin/login/ {
            limit_req zone=admin_login burst=5 nodelay;
            limit_req_status 429;
            include /etc/nginx/conf.d/proxy-backend.inc;
        }
        include /etc/nginx/conf.d/proxy-backend.inc;
    }

    # Token-carrying routes: same handling as the API/SPA locations below, but error lines (which would contain
    # the raw token) are limited to critical. ^~ keeps the /api regex location from taking these over. Failures
    # here still show in the redacted access log (status, ups=, urt=).
    location ^~ /api/invitations/preview/ {
        error_log /var/log/nginx/error.log crit;
        include /etc/nginx/conf.d/proxy-backend.inc;
    }
    location ^~ /reset-password/ {
        error_log /var/log/nginx/error.log crit;
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri /index.html;
    }
    location ^~ /invite/ {
        error_log /var/log/nginx/error.log crit;
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri /index.html;
    }

    # Django: REST API (incl. Stripe webhook; Swagger only where enabled) and the collected static files.
    location ~ ^/(api|static)/ {
        if ($fb_secret_query) {
            rewrite ^ /__fb_quiet$uri last;  # the query string is kept
        }
        include /etc/nginx/conf.d/proxy-backend.inc;
    }

    # Same proxying for API requests with a secret in the query string, with error lines limited to critical.
    location ^~ /__fb_quiet/ {
        internal;
        error_log /var/log/nginx/error.log crit;
        rewrite ^/__fb_quiet(/.*)$ $1 break;
        include /etc/nginx/conf.d/proxy-backend.inc;
    }

    location @not_found {
        return 404;
    }

    # Vite emits content-hashed file names, so they can be cached forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # SPA: every other path is a client-side route. (add_header in a location replaces the server-level ones,
    # so the security headers are included where they apply; Django sets its own on /api and /admin.)
    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
