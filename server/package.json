{
  "name": "vendora-server",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext js,json src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed/seed.js",
    "seed:fresh": "node scripts/seed-fresh.js",
    "test": "node --test --experimental-test-module-mocks --test-concurrency=1 \"test/**/*.test.js\"",
    "redis:check": "node scripts/redis-check.js",
    "s3:check": "node scripts/s3-check.js",
    "es:check": "node scripts/es-check.js"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@elastic/elasticsearch": "^8.19.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.7.0",
    "mongoose": "^8.24.7",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "pdfkit": "^0.15.2",
    "stripe": "^17.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
