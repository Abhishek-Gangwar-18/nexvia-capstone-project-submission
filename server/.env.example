# ─────────────────────────────────────────────────────────────────────────────
# Vendora API configuration
# Every external service is optional for local development: when a variable is
# left empty the API falls back to a local equivalent and logs which one it uses.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5050
# Public URL of this API (used to build URLs for locally stored uploads)
SERVER_URL=http://localhost:5050
# Frontend origin(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5180

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Local: `npm run db` starts an embedded MongoDB on this URI automatically.
# Production: your MongoDB Atlas connection string.
MONGO_URI=mongodb://127.0.0.1:27017/vendora
# Seed demo data automatically when the database is empty
AUTO_SEED=true
# Optional: DNS servers used for mongodb+srv lookups if the system resolver refuses them
# (happens with Node on some Windows setups). Default fallback: 8.8.8.8,1.1.1.1
DNS_SERVERS=

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Redis (cart + session cache) ─────────────────────────────────────────────
# e.g. redis://localhost:6379 or rediss://default:<password>@<host>:6379 (Upstash / Redis Cloud)
# Empty → in-memory cache
REDIS_URL=

# ── Elasticsearch (product search) ───────────────────────────────────────────
# e.g. http://localhost:9200 or your Elastic Cloud endpoint. Empty → MongoDB search
ELASTICSEARCH_NODE=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=vendora-products

# ── AWS S3 (image uploads) ───────────────────────────────────────────────────
# Empty → files are stored in server/uploads and served from /uploads
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Optional: CDN/CloudFront base URL for uploaded files
AWS_S3_PUBLIC_URL=
# Optional: S3-compatible endpoint (e.g. MinIO from docker-compose: http://localhost:9000)
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# ── Razorpay (payments + Route split payments) ───────────────────────────────
# Test keys from https://dashboard.razorpay.com/app/keys (test mode).
# Empty → built-in test gateway that simulates the same checkout flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email (verification mails) ───────────────────────────────────────────────
# Any SMTP provider (Resend, SES, Brevo, Gmail app password…).
# Empty → mails are not sent; the verification link is printed to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vendora <no-reply@vendora.dev>"
