# Copy to .env and adjust. Used by Django (backend/config/settings.py) and docker compose.

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-change-me-please-use-a-long-random-string-in-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=flowboard
POSTGRES_USER=flowboard
POSTGRES_PASSWORD=flowboard
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgres://flowboard:flowboard@localhost:5432/flowboard

# --- Redis / Celery ---
# Host port 6380 so it doesn't collide with another Redis already on 6379.
REDIS_HOST_PORT=6380
REDIS_URL=redis://localhost:6380/0
# Shared cache for rate-limit and login-lockout counters (required). Defaults to REDIS_URL with database /1,
# so it never touches the Celery broker on /0.
# CACHE_URL=redis://localhost:6380/1

# --- Limits ---
# MAX_OWNED_WORKSPACES=10
# MAX_WEBHOOKS_PER_WORKSPACE=10

# --- Email (default prints to the Celery worker's terminal) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=FlowBoard <no-reply@flowboard.test>
# For real delivery use django.core.mail.backends.smtp.EmailBackend and set:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# --- Security (production values live in docker-compose.prod.yml; see docs/ARCHITECTURE.md §7.2) ---
# API_DOCS=public                 # public | staff | off (default: public with DEBUG, off otherwise)
# CORS_ALLOWED_ORIGINS=           # only for a frontend on another origin; empty in production
# DJANGO_HSTS_SECONDS=0           # production: 31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_HSTS_PRELOAD=False
# nginx (frontend container):
# ADMIN_ALLOWLIST=*               # IPs/CIDRs allowed to open /admin/; empty = closed (production default)
# TRUSTED_PROXY_CIDRS=            # your TLS proxy, so X-Forwarded-For is trusted only from it
# CSP_HEADER=Content-Security-Policy   # or Content-Security-Policy-Report-Only while testing a change

# --- Stripe (use TEST keys from dashboard.stripe.com/test/apikeys; never commit real values) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
