# Copy to .env and adjust. Used by Django (backend/config/settings.py) and docker compose.

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-change-me-please-use-a-long-random-string-in-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=flowboard
POSTGRES_USER=flowboard
POSTGRES_PASSWORD=flowboard
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgres://flowboard:flowboard@localhost:5432/flowboard

# --- Redis / Celery ---
# Host port 6380 so it doesn't collide with another Redis already on 6379.
REDIS_HOST_PORT=6380
REDIS_URL=redis://localhost:6380/0

# --- Email (default prints to the Celery worker's terminal) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=FlowBoard <no-reply@flowboard.test>
# For real delivery use django.core.mail.backends.smtp.EmailBackend and set:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# --- Stripe (use TEST keys from dashboard.stripe.com/test/apikeys; never commit real values) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
