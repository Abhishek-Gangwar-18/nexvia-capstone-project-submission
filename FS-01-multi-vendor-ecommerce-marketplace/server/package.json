{
  "name": "vendora-server",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec \"node src/index.ts\"",
    "start": "node src/index.ts",
    "seed": "node src/seed/seed.ts",
    "seed:fresh": "node scripts/seed-fresh.ts",
    "test": "node --test --experimental-test-module-mocks --test-concurrency=1 \"test/**/*.test.ts\"",
    "redis:check": "node scripts/redis-check.ts",
    "s3:check": "node scripts/s3-check.ts",
    "es:check": "node scripts/es-check.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/api.integration.ts",
    "test:security": "node --test --test-concurrency=1 test/integration/security.integration.ts",
    "typecheck": "tsc -p ."
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@elastic/elasticsearch": "^8.19.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.7.0",
    "mongoose": "^8.24.7",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "pdfkit": "^0.15.2",
    "stripe": "^17.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.7",
    "nodemon": "^3.1.9",
    "typescript": "5.8.3"
  }
}
