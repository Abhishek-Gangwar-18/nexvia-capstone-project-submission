# ─────────────────────────────────────────────────────────────────────────────
# Vendora API configuration
# External services can be omitted in local development; the payment simulator
# requires the explicit ALLOW_TEST_GATEWAY=true opt-in below.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5050
# Public URL of this API (used to build URLs for locally stored uploads)
SERVER_URL=http://localhost:5050
# Frontend origin(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5180

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Local: `npm run db` starts an embedded MongoDB on this URI automatically.
# Production: your MongoDB Atlas connection string.
MONGO_URI=mongodb://127.0.0.1:27017/vendora
# Seed demo data automatically when the database is empty
AUTO_SEED=true
# Optional: DNS servers used for mongodb+srv lookups if the system resolver refuses them
# (happens with Node on some Windows setups). Default fallback: 8.8.8.8,1.1.1.1
DNS_SERVERS=

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
# Access token lifetime (JWT in memory); the refresh token lives in an httpOnly cookie.
ACCESS_TOKEN_TTL=15m
REFRESH_IDLE_DAYS=30
SESSION_MAX_DAYS=90
# lax = client and API on the same site (dev proxy); none = API on another domain (requires HTTPS)
COOKIE_SAMESITE=lax

# ── Redis (sessions, locks, rate limits, caches) ─────────────────────────────
# Local (Docker): `docker compose up -d redis` from the repo root, then redis://localhost:6379
# Production: a hosted Redis, e.g. rediss://default:<password>@<host>:6379 (Upstash: rediss://, two s)
# Empty → in-memory store in development. Production refuses to start without it, unless
# ALLOW_MEMORY_CACHE=true (only for a single-instance demo). Check a URL with: pnpm redis:check
REDIS_URL=
ALLOW_MEMORY_CACHE=false

# ── Elasticsearch (product search) ───────────────────────────────────────────
# e.g. http://localhost:9200 (docker compose up -d elasticsearch) or your Elastic Cloud endpoint.
# Empty → MongoDB search. ELASTICSEARCH_INDEX is the alias the API builds and switches. Check with: pnpm es:check
ELASTICSEARCH_NODE=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=vendora-products

# ── AWS S3 (image uploads) ───────────────────────────────────────────────────
# Empty → files are stored in server/uploads and served from /uploads
# The bucket policy allows public s3:GetObject on products/*, stores/*, avatars/*, reviews/*, returns/*;
# the IAM user only needs s3:PutObject and s3:DeleteObject. Check the bucket with: pnpm s3:check
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Optional: CDN/CloudFront base URL for uploaded files
AWS_S3_PUBLIC_URL=
# Optional: S3-compatible endpoint (e.g. MinIO from docker-compose: http://localhost:9000)
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# ── Stripe (payments, refunds, Connect payouts to vendors) ───────────────────
# Keys from https://dashboard.stripe.com/test/apikeys (test mode: sk_test_… / pk_test_…).
# Empty → built-in test gateway only when ALLOW_TEST_GATEWAY=true below.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint (whsec_…), or the one printed by `stripe listen`
STRIPE_WEBHOOK_SECRET=
# Only if you add a second endpoint for "Connected accounts" events (vendor onboarding, bank changes)
STRIPE_CONNECT_WEBHOOK_SECRET=
# Charge currency; catalogue prices are in this currency
STRIPE_CURRENCY=inr
# Country for vendor Express accounts (e.g. IN, US); empty = your Stripe account's country
STRIPE_CONNECT_COUNTRY=
# Explicitly allow the built-in gateway (orders get "paid" without money); false is safe for every environment.
ALLOW_TEST_GATEWAY=false

# Days after delivery for returns; vendors are paid once this window has passed with no open return
RETURN_WINDOW_DAYS=7

# ── Orders ───────────────────────────────────────────────────────────────────
# Minutes an unpaid order holds its stock before it is cancelled and the stock released
STOCK_RESERVATION_MINUTES=15
